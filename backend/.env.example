# Copy this file to ".env" and adjust the values.
PORT=4000

# Local MongoDB, or paste your MongoDB Atlas connection string here.
MONGO_URI=mongodb://127.0.0.1:27017/school_management

# Use a long random string in real projects. Never commit the real .env file.
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d

# The frontend origin that is allowed to call this API (CORS).
CLIENT_URL=http://localhost:5173
